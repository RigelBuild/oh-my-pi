# syntax=docker/dockerfile:1.7-labs

ARG BUN_VERSION=1.4.4

FROM rust:1.86-slim-bookworm AS builder

ARG BUN_VERSION
ENV BUN_INSTALL=/opt/bun \
    PATH=/opt/bun/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin \
    CARGO_TERM_COLOR=never \
    OMP_NATIVE_CARGO_PROFILE=ci

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl pkg-config libssl-dev unzip git \
        clang libclang-dev cmake make ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" \
    && /opt/bun/bin/bun --version

WORKDIR /omp

COPY rust-toolchain.toml /omp/
RUN rustup show

COPY --parents \
    package.json bun.lock bunfig.toml \
    patches/*.patch \
    tsconfig.base.json tsconfig.json \
    Cargo.toml Cargo.lock rust-toolchain.toml \
    packages/*/package.json \
    packages/tsconfig.workspace.json \
    python/robomp/web/package.json \
    crates/*/Cargo.toml \
    /omp/

RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --ignore-scripts

COPY . /omp/

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/omp/target \
    bun --cwd=packages/natives run build \
    && bun --cwd=packages/coding-agent run build

FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

COPY --from=builder /omp/packages/coding-agent/dist/omp /usr/local/bin/omp

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/omp"]
CMD ["--help"]
